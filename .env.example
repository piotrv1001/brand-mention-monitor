# https://console.apify.com/settings/integrations
APIFY_TOKEN=your_apify_token_here

# Matches docker-compose.yml
DATABASE_URL=postgres://mentions:mentions@localhost:5432/mentions

# Only posts from the last N days (the first run can go further back)
LOOKBACK_DAYS=7
# Results per keyword and source
MAX_PER_SOURCE=30
# Google News edition
NEWS_COUNTRY=US
NEWS_LANGUAGE=en
